# last.fm, for the "on repeat" pebbles on /listening.
#
# Both are read on the server only — never prefixed NEXT_PUBLIC_, never
# imported by a client component, and a test asserts neither name reaches the
# browser bundle. Copy this file to .env.local and fill it in; .env.local is
# gitignored.
#
# The key comes from https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USER=

# Upstash Redis, for the shared count of fish feedings under the name on the
# homepage (lib/feedCount.ts). Server only, like the last.fm pair.
#
# Add Upstash Redis to the project from the Vercel dashboard (Storage →
# Marketplace); it sets the KV_ pair itself, and `vercel env pull .env.local`
# brings them here. The UPSTASH_ pair works too, if you'd rather make the
# database on upstash.com. Without either, the fish can still be fed; the
# count just isn't shown.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
